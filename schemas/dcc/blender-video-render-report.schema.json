{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://block-creative.local/schema/dcc/blender-video-render-report-v1.json",
  "title": "BCS Blender Video Render Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contractVersion", "status", "source", "output", "blender", "render", "metrics", "warnings", "errors"],
  "properties": {
    "contract": { "const": "bcs.blender-video-render-report" },
    "contractVersion": { "const": "1.0.0" },
    "status": { "enum": ["passed", "failed"] },
    "source": { "$ref": "#/$defs/artifact" },
    "output": { "$ref": "#/$defs/artifact" },
    "blender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "engine"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "frameStart", "frameEnd", "frameCount", "durationSeconds", "quality", "constantRateFactor", "preset"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "frameStart": { "type": "integer", "minimum": 1 },
        "frameEnd": { "type": "integer", "minimum": 1 },
        "frameCount": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "quality": { "enum": ["draft", "standard", "cinematic"] },
        "constantRateFactor": { "enum": ["MEDIUM", "HIGH", "PERC_LOSSLESS"] },
        "preset": { "enum": ["REALTIME", "GOOD"] }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderDurationMs"],
      "properties": { "renderDurationMs": { "type": "integer", "minimum": 0 } }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
