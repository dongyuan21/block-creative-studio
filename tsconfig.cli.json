{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist-cli",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "sourceMap": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/headless/**/*.ts",
    "src/cli/**/*.ts",
    "src/game-runtime/**/*.ts",
    "src/games/block-placement/**/*.ts",
    "src/domain/**/*.ts",
    "src/director/**/*.ts",
    "src/bootstrap/**/*.ts",
    "src/rendering/**/*.ts"
  ],
  "exclude": [
    "src/games/block-placement/studio/**",
    "src/bootstrap/platformBootstrap.ts"
  ]
}
