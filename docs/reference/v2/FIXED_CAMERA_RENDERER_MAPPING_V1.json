{
  "schemaVersion": "1.0.0",
  "rendererId": "fixed-camera-cinematic",
  "label": "固定机位混合影视渲染器",
  "sourceOfTruth": "ASSET_LINEAGE_V2.json",
  "principles": [
    "Gameplay, replay, score events and clear topology remain renderer-independent.",
    "The camera transform is locked per CameraProfile; screen-space feedback may add small translate/scale/shake only.",
    "Tiles and material-consistent large fragments prefer true 3D.",
    "HUD, praise, combo, score glyphs and endgame UI remain screen-space 2D.",
    "Pre-clear fills, sweeps, border glow and exposure reactions are shader/render recipes.",
    "Complex smoke, flowers or hero effects may use baked-view sprites bound to the camera profile."
  ],
  "representationDefinitions": {
    "screen-2d": "Pixel-aligned overlay; unaffected by world depth.",
    "camera-facing-2d": "Billboard/sprite placed in scene depth but facing the locked camera.",
    "procedural-screen-vfx": "Shader or render-graph effect evaluated in board/screen coordinates.",
    "camera-profile-dependent-layout": "A layout contract mapping design pixels to fixed camera/world coordinates.",
    "normal-mapped-sprite": "Layered sprite with normal/roughness/edge masks for pseudo-volume.",
    "shallow-3d": "Thin geometry used for frame, slots or panels.",
    "full-3d": "True geometry with material, depth, occlusion and lighting.",
    "baked-view-sprite": "Pre-rendered DCC/AE output tied to the fixed camera profile.",
    "baked-transform-3d": "True geometry whose transforms are precomputed offline.",
    "motion-recipe": "Renderer-independent timing/spatial curve.",
    "nonvisual-rule": "Gameplay/director truth; no direct pixels."
  },
  "cameraProfileContract": {
    "requiredFields": [
      "id",
      "projection",
      "designResolution",
      "boardScreenRect",
      "pose",
      "lensOrOrthoScale",
      "motionPolicy"
    ],
    "motionPolicy": {
      "transformAnimation": false,
      "orbit": false,
      "lensAnimation": false,
      "screenShake": true,
      "screenZoomMax": 1.03
    }
  },
