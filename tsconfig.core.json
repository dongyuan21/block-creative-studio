{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": ".core-dist",
    "rootDir": "src",
    "esModuleInterop": true
  },
  "include": ["src/domain/**/*.ts", "src/director/**/*.ts"]
}
